# Copy to .env and set a unique database password before starting Compose.
POSTGRES_PASSWORD=replace-with-a-strong-password

# Set this after registering a tap in the node UI. Do not commit real secrets.
LEADER_SECRET=

# For a trusted local demo with a self-signed node certificate only,
# set this to true. Prefer a trusted certificate in normal deployments.
ACCEPT_INSECURE_CERTS=false
LEADER_URL=https://127.0.0.1:22900
